<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HerdrTray</RootNamespace>
    <AssemblyName>Herdr Tray Utility</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>alexkutkin</Company>
    <Product>Herdr Tray Utility</Product>
    <AssemblyTitle>Herdr Tray Utility</AssemblyTitle>
    <Description>Agent status in the notification area</Description>
    <!-- No debug symbols in distributed builds, including local PDB paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="app.ico" LogicalName="HerdrTray.app.ico" />
  </ItemGroup>

</Project>
